---
// Reach × harm matrix: how far did it get, and how bad was it.
import { incidents, REACH, HARM, url } from "../lib/data";

const count = (r: string, h: string) => incidents.filter((i) => i.assessment.reach.level === r && i.assessment.harm.severity === h).length;
const max = Math.max(1, ...REACH.flatMap((r) => HARM.map((h) => count(r, h))));
const step = (n: number) => (n === 0 ? 0 : Math.max(1, Math.ceil((n / max) * 5)));
// Ink flips to white on the darker steps (light mode) / dark on lighter steps (dark mode) via classes.
---
<figure class="chart">
  <figcaption>
    <p class="chart-title">Reach × harm</p>
    <p class="chart-sub">Number of incidents. Rows run from lab-only to the real world, and columns are the harm that actually occurred.</p>
  </figcaption>
  <table class="heat">
    <thead><tr><th></th>{HARM.map((h) => <th scope="col">{h}</th>)}</tr></thead>
    <tbody>
      {[...REACH].reverse().map((r) => (
        <tr>
          <th scope="row">{r}</th>
          {HARM.map((h) => {
            const n = count(r, h);
            const s = step(n);
            return (
              <td
                class={`heat-${s}`} tabindex={n ? "0" : undefined}
                style={`background: var(--seq-${s})`}
                data-tip={`${r} · harm ${h}: ${n} incident${n === 1 ? "" : "s"}`}
              >{n || ""}</td>
            );
          })}
        </tr>
      ))}
    </tbody>
  </table>
</figure>
<style>
  .heat-0 { color: var(--muted); }
  .heat-1, .heat-2 { color: #0b0b0b; }
  .heat-3, .heat-4, .heat-5 { color: #ffffff; }
  @media (prefers-color-scheme: dark) {
    .heat-1, .heat-2, .heat-3 { color: #ffffff; }
    .heat-4, .heat-5 { color: #0b0b0b; }
  }
</style>
