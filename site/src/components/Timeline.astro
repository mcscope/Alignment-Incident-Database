---
// Dot timeline of incidents. Each dot is one incident (repeated across lanes in
// the lane views). Size is harm severity. Color depends on the view:
//   time      one axis, colored by developer
//   developer one lane per developer, colored by reach
//   behavior  one lane per behavior, colored by developer
// Dots in the same month stack upward, so nothing overlaps.
import {
  type Incident, incidents as allIncidents, url, formatDate, orgById, behaviorById,
  DEV_COLORS, developers, devGroup, HARM_RADIUS, HARM, REACH, filterAttrs, timelineDate,
} from "../lib/data";
import OrgLogo from "./OrgLogo.astro";
import logoManifest from "../../public/logos/index.json";

type View = "time" | "developer" | "behavior";
interface Props { views?: View[]; incidents?: Incident[]; filterable?: boolean; id?: string }
const { views = ["time"], incidents = allIncidents, filterable = false, id = "timeline" } = Astro.props;

// ----- time axis: whole months, Jan of the first year through the current month -----
// Position in months since year 0, at day precision when the date has a day.
// Month-only dates sit mid-month; year-only dates sit mid-year.
const monthIndex = (date: string) => {
  const [y, m, d] = date.split("-").map(Number);
  if (!m) return y * 12 + 6;
  const days = new Date(Date.UTC(y, m, 0)).getUTCDate();
  return y * 12 + (m - 1) + (d ? (d - 0.5) / days : 0.5);
};
const now = new Date();
const startYear = Math.min(...incidents.map((i) => +i.date.slice(0, 4)));
const start = startYear * 12;
const end = Math.max(now.getUTCFullYear() * 12 + now.getUTCMonth(), ...incidents.map((i) => Math.floor(monthIndex(i.date)))) + 1;
const span = end - start;
const xPct = (i: Incident) => ((monthIndex(timelineDate(i).date) - start) / span) * 100;
const years = Array.from({ length: Math.ceil(span / 12) + 1 }, (_, k) => startYear + k).filter((y) => (y * 12 - start) / span < 1);

// ----- colors -----
const devColor = (i: Incident) => {
  const g = devGroup(i);
  if (g === "multiple") return { color: "transparent", hollow: true };
  return { color: DEV_COLORS.find((c) => c.id === g)?.color ?? "var(--dev-other)", hollow: false };
};
const reachColor = (i: Incident) => ({ color: `var(--reach-${i.assessment.reach.level})`, hollow: false });
const devLabel = (i: Incident) => developers(i).map((d) => orgById.get(d)?.name ?? d).join(", ") || "Undisclosed";

type Dot = { i: Incident; x: number; r: number; bottom: number; color: string; hollow: boolean; logo?: string | null };
type Lane = { key: string; label?: string; href?: string; dots: Dot[]; height: number; logo?: string };

// Logo mode (Timeline and By-behavior views): each dot is the developer's logo,
// sized by harm (logos need a minimum size to be legible) with a harm-colored ring.
const LOGO_RADIUS: Record<string, number> = { none: 12, minor: 14, moderate: 17, severe: 21 };
// One logo per developer, so a multi-developer incident shows every developer.
const logoOf = (i: Incident) => {
  const devs = developers(i);
  const file = (d: string) => (logoManifest as Record<string, string>)[d];
  return (devs.length ? devs : [""]).map((d) => ({ color: "transparent", hollow: false, logo: d && file(d) ? url(`/logos/${file(d)}`) : null }));
};

type DotStyle = { color: string; hollow: boolean; logo?: string | null };
function lane(key: string, list: Incident[], colorOf: (i: Incident) => DotStyle | DotStyle[], label?: string, href?: string): Lane {
  // Stack dots that share a month; biggest at the bottom.
  const bins = new Map<number, Incident[]>();
  for (const i of list) {
    const b = Math.floor(monthIndex(timelineDate(i).date));
    bins.set(b, [...(bins.get(b) ?? []), i]);
  }
  const dots: Dot[] = [];
  let height = 0;
  for (const group of bins.values()) {
    let bottom = 4;
    for (const i of group.sort((a, b) => HARM_RADIUS[b.assessment.harm.severity] - HARM_RADIUS[a.assessment.harm.severity])) {
      for (const c of ([] as DotStyle[]).concat(colorOf(i))) {
        const r = ("logo" in c ? LOGO_RADIUS : HARM_RADIUS)[i.assessment.harm.severity];
        dots.push({ i, x: xPct(i), r, bottom, ...c });
        bottom += 2 * r + 4;
      }
    }
    height = Math.max(height, bottom);
  }
  return { key, label, href, dots, height: Math.max(height + 6, 40) };
}

const byCount = <T,>(entries: [T, Incident[]][]) => entries.sort((a, b) => b[1].length - a[1].length);

const laneSets: Record<View, Lane[]> = {
  time: [lane("all", incidents, logoOf)],
  developer: (() => {
    const groups = new Map<string, Incident[]>();
    for (const i of incidents) {
      const devs = developers(i);
      for (const d of devs.length ? devs : ["undisclosed"]) groups.set(d, [...(groups.get(d) ?? []), i]);
    }
    return byCount([...groups]).map(([d, list]) =>
      d === "undisclosed"
        ? lane(d, list, reachColor, "Undisclosed")
        : { ...lane(d, list, reachColor, orgById.get(d)?.name ?? d, url(`/organizations/${d}/`)), logo: d });
  })(),
  behavior: (() => {
    const groups = new Map<string, Incident[]>();
    for (const i of incidents) for (const b of i.behaviors) groups.set(b, [...(groups.get(b) ?? []), i]);
    return byCount([...groups]).slice(0, 10).map(([b, list]) =>
      lane(b, list, logoOf, behaviorById.get(b)?.name ?? b, url(`/behaviors/${b}/`)));
  })(),
};

const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const months = Array.from({ length: span }, (_, k) => ({ x: (k / span) * 100, m: (start + k) % 12, y: Math.floor((start + k) / 12) }));
// Default window: the current year to now. Anything earlier is history, scrolled off to the left.
const defaultFrom = Math.max(0, Math.min(span - 1, now.getUTCFullYear() * 12 - start));

const viewNames: Record<View, string> = { time: "Timeline", developer: "By developer", behavior: "By behavior" };
const viewSubs: Record<View, string> = {
  time: "Every incident by date. The icon shows the model's developer; size and ring show harm.",
  developer: "One lane per developer whose models were involved. Color shows how far the behavior reached.",
  behavior: "One lane per behavior (top 10). An incident appears in each of its behaviors. The icon shows the developer; size and ring show harm.",
};
const cap = (s: string) => s[0].toUpperCase() + s.slice(1);
const when = (i: Incident) => {
  const t = timelineDate(i);
  return t.kind === "first-reported" ? `Occurred ${formatDate(i.date)} · first reported ${formatDate(t.date)}` : formatDate(i.date);
};
const tip = (i: Incident) =>
  `${i.id} · ${when(i)}\n${i.title}\n${devLabel(i)} · reach: ${i.assessment.reach.level} · harm: ${i.assessment.harm.severity}`;
---
<figure class="tl" id={id} data-views={views.join(" ")} data-span={span} data-default-from={defaultFrom}>
  <div class="tl-toolbar">
    {views.length > 1 && (
      <div class="tl-tabs" role="tablist" aria-label="Timeline view">
        {views.map((v, n) => <button type="button" role="tab" data-view={v} aria-selected={n === 0 ? "true" : "false"}>{viewNames[v]}</button>)}
      </div>
    )}
    <div class="tl-zoom" role="group" aria-label="Zoom">
      <button type="button" data-zoom="year" aria-pressed="true">{now.getUTCFullYear()}</button>
      <button type="button" data-zoom="24">2 yrs</button>
      <button type="button" data-zoom="60">5 yrs</button>
      <button type="button" data-zoom="all">All</button>
      <button type="button" data-zoom="in" aria-label="Zoom in">+</button>
      <button type="button" data-zoom="out" aria-label="Zoom out">−</button>
    </div>
  </div>

  {views.map((v, n) => (
    <div class="tl-view" data-view={v} hidden={n > 0} role={views.length > 1 ? "tabpanel" : undefined}>
      <div class="tl-legends">
        {v === "developer" ? (
          <div class="legend">
            {REACH.map((r) => <span><i class="tl-key" style={`background: var(--reach-${r})`} />{cap(r)}</span>)}
          </div>
        ) : (
          <div class="legend"></div>
        )}
        {v === "developer" ? (
          <div class="legend tl-sizes" aria-label="Dot size: harm">
            <span>Harm:</span>
            {HARM.map((h) => <span><i class="tl-size" style={`width:${HARM_RADIUS[h] * 2}px;height:${HARM_RADIUS[h] * 2}px`} />{h}</span>)}
          </div>
        ) : (
          <div class="legend tl-sizes" aria-label="Icon size and ring: harm">
            <span>Harm:</span>
            {HARM.map((h) => <span><i class="tl-size tl-ring" style={`width:${LOGO_RADIUS[h] * 2}px;height:${LOGO_RADIUS[h] * 2}px; --ring: var(--harm-${h})`} />{h}</span>)}
          </div>
        )}
      </div>

      <div class="tl-scroller" tabindex="0" aria-label="Timeline; scroll sideways for earlier incidents">
        <div class="tl-canvas">
          {laneSets[v].map((l) => (
            <div class="tl-track" data-labelled={l.label ? "" : undefined} style={`height:${l.height + (l.label ? 18 : 0)}px`}>
              {months.map((mo) => <span class={mo.m === 0 ? "tl-grid" : "tl-mgrid"} style={`left:${mo.x}%`} />)}
              {l.label && <span class="tl-label with-logo">{l.logo && <OrgLogo id={l.logo} size={15} title={false} />}{l.href ? <a href={l.href}>{l.label}</a> : l.label}</span>}
              {l.dots.map((d) => (
                <a
                  class={`tl-dot${d.hollow ? " hollow" : ""}${"logo" in d ? " logo" : ""}`}
                  data-x={d.x.toFixed(4)}
                  data-r={d.r}
                  href={url(`/incidents/${d.i.id}/`)}
                  style={`left:${d.x}%; bottom:${d.bottom}px; width:${d.r * 2}px; height:${d.r * 2}px; ${"logo" in d ? `--ring: var(--harm-${d.i.assessment.harm.severity})` : `background:${d.color}`}`}
                  data-tip={tip(d.i)}
                  aria-label={`${d.i.id}: ${d.i.title}`}
                  {...(filterable ? { "data-filterable": "", ...filterAttrs(d.i) } : {})}
                >{"logo" in d && (d.logo ? <img src={d.logo} alt="" loading="lazy" decoding="async" /> : <span class="tl-unknown">?</span>)}</a>
              ))}
            </div>
          ))}
          <div class="tl-axis">
            {months.map((mo) => mo.m === 0
              ? <span class="tl-ylabel" style={`left:${mo.x}%`}>{mo.y}</span>
              : <span class="tl-mlabel" style={`left:${mo.x}%`}>{monthNames[mo.m]}</span>)}
          </div>
        </div>
      </div>
    </div>
  ))}

  <details class="table-view">
    <summary>Table</summary>
    <table>
      <thead><tr><th>Date</th><th>Id</th><th>Developer</th><th>Reach</th><th>Harm</th></tr></thead>
      <tbody>
        {[...incidents].sort((a, b) => a.date.localeCompare(b.date)).map((i) => (
          <tr><td>{i.date}</td><td><a href={url(`/incidents/${i.id}/`)}>{i.id}</a></td><td>{devLabel(i)}</td><td>{i.assessment.reach.level}</td><td>{i.assessment.harm.severity}</td></tr>
        ))}
      </tbody>
    </table>
  </details>
</figure>

<script>
  // View tabs (selected view kept in the URL hash, #view=developer) and zoom.
  // Zoom sets how many months fill the visible width; dots are positioned in % of
  // the full span, so only the canvas width changes. Default: current year to now,
  // with earlier years scrolled off to the left.
  for (const fig of document.querySelectorAll<HTMLElement>("figure.tl")) {
    const span = Number(fig.dataset.span);
    const defaultFrom = Number(fig.dataset.defaultFrom);
    let visible = Math.max(3, span - defaultFrom + 0.6); // months in view (+ a little so the year label shows)
    let anchor: "right" | number = "right";       // keep right edge, or a centre month

    const activeScroller = () => [...fig.querySelectorAll<HTMLElement>(".tl-view")].find((v) => !v.hidden)?.querySelector<HTMLElement>(".tl-scroller");
    function apply(center?: number) {
      const sc = activeScroller();
      if (!sc || !sc.clientWidth) return;
      visible = Math.min(span, Math.max(3, visible));
      const width = (sc.clientWidth * span) / visible;
      for (const c of fig.querySelectorAll<HTMLElement>(".tl-canvas")) c.style.width = `${width}px`;
      fig.classList.toggle("tl-fine", width / span >= 34);
      for (const t of fig.querySelectorAll<HTMLElement>(".tl-track")) layout(t, width);
      const target = center ?? (anchor === "right" ? span : anchor);
      sc.scrollLeft = anchor === "right" && center === undefined ? sc.scrollWidth : (target / span) * width - sc.clientWidth / 2;
    }
    // Stack dots only where they overlap at the current zoom: place each dot (left
    // to right, larger first at equal x) at the lowest height that clears every
    // already-placed dot it would touch.
    function layout(track: HTMLElement, width: number) {
      const dots = [...track.querySelectorAll<HTMLElement>(".tl-dot")]
        .map((el) => ({ el, px: (Number(el.dataset.x) / 100) * width, r: Number(el.dataset.r), b: 0 }))
        .sort((p, q) => p.px - q.px || q.r - p.r);
      const placed: typeof dots = [];
      let top = 0;
      for (const d of dots) {
        d.b = 4;
        for (let guard = 0; guard < 50; guard++) {
          const hit = placed.find((p) => Math.abs(p.px - d.px) < p.r + d.r + 2 && d.b < p.b + 2 * p.r + 3 && p.b < d.b + 2 * d.r + 3);
          if (!hit) break;
          d.b = hit.b + 2 * hit.r + 3;
        }
        d.el.style.bottom = `${d.b}px`;
        placed.push(d);
        top = Math.max(top, d.b + 2 * d.r);
      }
      track.style.height = `${Math.max(40, top + 8) + (track.hasAttribute("data-labelled") ? 18 : 0)}px`;
    }
    const centerMonth = () => { const sc = activeScroller(); return sc ? ((sc.scrollLeft + sc.clientWidth / 2) / sc.scrollWidth) * span : span; };
    const press = (key: string) => { for (const b of fig.querySelectorAll<HTMLElement>("[data-zoom]")) if (!["in", "out"].includes(b.dataset.zoom!)) b.setAttribute("aria-pressed", String(b.dataset.zoom === key)); };

    for (const b of fig.querySelectorAll<HTMLButtonElement>("[data-zoom]")) {
      b.addEventListener("click", () => {
        const z = b.dataset.zoom!;
        if (z === "in" || z === "out") {
          const c = centerMonth();
          visible = z === "in" ? visible / 2 : visible * 2;
          anchor = c; press(""); apply(c);
          return;
        }
        visible = z === "year" ? span - defaultFrom + 0.6 : z === "all" ? span : Number(z);
        anchor = "right"; press(z); apply();
      });
    }

    const tabs = [...fig.querySelectorAll<HTMLButtonElement>(".tl-tabs [data-view]")];
    const show = (view: string) => {
      if (!tabs.length) return;
      if (!tabs.some((t) => t.dataset.view === view)) view = tabs[0].dataset.view!;
      for (const t of tabs) t.setAttribute("aria-selected", String(t.dataset.view === view));
      for (const p of fig.querySelectorAll<HTMLElement>(".tl-view")) p.hidden = p.dataset.view !== view;
    };
    for (const t of tabs) t.addEventListener("click", () => {
      const c = centerMonth();
      show(t.dataset.view!); history.replaceState(null, "", `#view=${t.dataset.view}`);
      apply(anchor === "right" ? undefined : c);
    });
    show(new URLSearchParams(location.hash.slice(1)).get("view") ?? "");
    apply();
    new ResizeObserver(() => apply()).observe(fig);
  }
</script>
