---
// Models, one card per developer. The card shows the developer's incidents at a
// glance; its models (newest activity first) appear when the card is expanded.
// Built from the taxonomy, so new models and developers appear automatically.
import Base from "../../layouts/Base.astro";
import ReachBars from "../../components/ReachBars.astro";
import OrgLogo from "../../components/OrgLogo.astro";
import { incidents, models, orgById, HARM, url, formatDate, type Incident, type Term } from "../../lib/data";

const byModel = new Map<string, Incident[]>(models.map((m) => [m.id, incidents.filter((i) => i.models.includes(m.id))]));
const latest = (list: Incident[]) => list.reduce((d, i) => (i.date > d ? i.date : d), "");

type Dev = { id: string; name: string; href?: string; models: Term[]; incidents: Incident[] };
const devs = new Map<string, Dev>();
for (const m of models) {
  if (!byModel.get(m.id)!.length) continue;
  const id = m.developer ?? "other";
  const dev = devs.get(id) ?? { id, name: id === "other" ? "Other and undisclosed" : orgById.get(id)?.name ?? id, href: id === "other" ? undefined : url(`/organizations/${id}/`), models: [], incidents: [] };
  dev.models.push(m);
  devs.set(id, dev);
}
for (const d of devs.values()) {
  // Distinct incidents, so a multi-model incident counts once per developer.
  d.incidents = [...new Map(d.models.flatMap((m) => byModel.get(m.id)!).map((i) => [i.id, i])).values()];
  // Newest activity first: most recent incident, then incident count.
  d.models.sort((a, b) => latest(byModel.get(b.id)!).localeCompare(latest(byModel.get(a.id)!)) || byModel.get(b.id)!.length - byModel.get(a.id)!.length);
}
const devList = [...devs.values()].sort((a, b) => (a.id === "other" ? 1 : b.id === "other" ? -1 : b.incidents.length - a.incidents.length || a.name.localeCompare(b.name)));
const modelCount = devList.reduce((n, d) => n + d.models.filter((m) => m.id !== "unknown").length, 0);
const max = Math.max(...devList.map((x) => x.incidents.length));
const cap = (s: string) => s[0].toUpperCase() + s.slice(1);
---
<Base title="Models" nav="models" description="AI models in recorded incidents, by developer.">
  <h1>Models</h1>
  <div class="legend">
    <span>Harm:</span>
    {HARM.map((h) => <span><i style={`background: var(--harm-${h}); border-radius: 3px`} />{cap(h)}</span>)}
  </div>

  <div class="dev-grid">
    {devList.map((d) => (
      <details class="chart-card dev-card">
        <summary>
          <div class="dev-top">
            <span class="with-logo dev-name">
              {d.id !== "other" ? <OrgLogo id={d.id} size={28} title={false} /> : <span class="org-logo org-initials" style="--logo:28px">?</span>}
              <span>{d.name}</span>
            </span>
            <span class="muted small">{d.incidents.length} incident{d.incidents.length === 1 ? "" : "s"} · {d.models.length} model{d.models.length === 1 ? "" : "s"}</span>
          </div>
          <ReachBars compact by="harm" max={max} rows={[{ label: d.name, incidents: d.incidents }]} label={`${d.name} incidents by harm`} />
          <span class="dev-more small">
            <span class="when-closed">Show models</span><span class="when-open">Hide models</span>
            <span class="muted"> · latest {formatDate(latest(d.incidents))}</span>
          </span>
        </summary>
        <div class="dev-models">
          <ReachBars
            by="harm"
            label={`${d.name} incidents per model`}
            rows={d.models.map((m) => ({ label: m.name, href: url(`/models/${m.id}/`), incidents: byModel.get(m.id)! }))}
          />
          {d.href && <p class="small" style="margin:10px 0 0"><a href={d.href}>All {d.name} incidents by role →</a></p>}
        </div>
      </details>
    ))}
  </div>
</Base>

<style>
  .dev-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr)); gap: 14px; align-items: start; margin-top: 8px; }
  .dev-card summary { list-style: none; cursor: pointer; display: grid; gap: 10px; }
  .dev-card summary::-webkit-details-marker { display: none; }
  .dev-card summary:focus-visible { outline: 2px solid var(--link); outline-offset: 4px; border-radius: 6px; }
  .dev-top { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
  .dev-name { font-weight: 650; font-size: 1.05rem; gap: 10px; }
  .dev-more { color: var(--link); }
  .dev-card .when-open { display: none; }
  .dev-card[open] .when-open { display: inline; }
  .dev-card[open] .when-closed { display: none; }
  .dev-models { border-top: 1px solid var(--border); margin-top: 12px; padding-top: 12px; }
</style>
