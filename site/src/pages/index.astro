---
// Home: an information hierarchy from broad to deep.
//   1. Overview: what this is, headline numbers, the timeline, and top patterns
//   2. Latest: recently added records and the highest-impact ones
//   3. Explore: routes into search/filter and every other view
import Base from "../layouts/Base.astro";
import IncidentList from "../components/IncidentList.astro";
import Timeline from "../components/Timeline.astro";
import HBars from "../components/HBars.astro";
import {
  incidents, behaviors, organizations, models, scanStats, url, formatUsd, formatDate,
  HARM, REACH, developers,
} from "../lib/data";

const n = incidents.length;
const realWorld = incidents.filter((i) => ["deployed", "breakout"].includes(i.assessment.reach.level)).length;
const low = incidents.reduce((s, i) => s + (i.assessment.monetary_damage.low_usd ?? 0), 0);
const high = incidents.reduce((s, i) => s + (i.assessment.monetary_damage.high_usd ?? 0), 0);
const unestimated = incidents.filter((i) => i.assessment.monetary_damage.low_usd === null).length;
const modelCount = new Set(incidents.flatMap((i) => i.models).filter((m) => m !== "unknown")).size;

// Latest: by when the record was added, then by incident date.
const latest = [...incidents]
  .sort((a, b) => b.record.created.localeCompare(a.record.created) || b.date.localeCompare(a.date) || b.id.localeCompare(a.id))
  .slice(0, 5);
// Highest impact: harm first, then reach, then recency.
const impact = [...incidents]
  .sort((a, b) =>
    HARM.indexOf(b.assessment.harm.severity) - HARM.indexOf(a.assessment.harm.severity) ||
    REACH.indexOf(b.assessment.reach.level) - REACH.indexOf(a.assessment.reach.level) ||
    b.date.localeCompare(a.date))
  .slice(0, 5);

const top = <T extends { id: string; name: string }>(terms: T[], count: (id: string) => number, path: string) =>
  terms.map((t) => ({ label: t.name, value: count(t.id), href: url(`/${path}/${t.id}/`), logo: path === "organizations" ? t.id : undefined }))
    .filter((x) => x.value > 0).sort((a, b) => b.value - a.value || a.label.localeCompare(b.label)).slice(0, 5);
const topBehaviors = top(behaviors, (id) => incidents.filter((i) => i.behaviors.includes(id)).length, "behaviors");
const topDevelopers = top(organizations, (id) => incidents.filter((i) => developers(i).includes(id)).length, "organizations");
---
<Base nav="home">
  <!-- 1. Overview -->
  <section class="hero">
    <h1>A public record of AI systems misbehaving</h1>
    <p class="lede">
      {n} documented incidents of AI systems acting against the intent of their developers, deployers, or
      users, from lab findings to real-world harm. Like a CVE list for alignment: every incident gets a permanent
      id, and every claim links to its source.
    </p>
    <form class="hero-search" action={url("/incidents/")} method="get" role="search">
      <input type="search" name="q" placeholder="Search incidents, models, behaviors…" aria-label="Search incidents" />
      <button class="btn" type="submit">Search</button>
    </form>
    <div class="hero-links">
      <a href={url("/incidents/")}>Browse all {n} incidents</a>
      <a href={url("/timeline/")}>Timeline</a>
      <a href={url("/data/")}>Data &amp; charts</a>
      <a href={url("/about/")}>How this works</a>
    </div>
  </section>

  <section class="stats" aria-label="Headline numbers">
    <div class="stat"><div class="stat-value">{n}</div><div class="stat-label">Incidents recorded</div></div>
    <div class="stat"><div class="stat-value">{realWorld}</div><div class="stat-label">Reached the real world</div></div>
    <div class="stat"><div class="stat-value">{modelCount}</div><div class="stat-label">Models implicated</div></div>
    <div class="stat">
      <div class="stat-value">{unestimated && !high ? "Unknown" : low === high ? formatUsd(low) : `${formatUsd(low)}–${formatUsd(high)}`}</div>
      <div class="stat-label">Est. monetary damage{unestimated ? ` · ${unestimated} not yet estimable` : ""}</div>
    </div>
  </section>

  <section class="chart-card">
    <div class="section-head" style="margin-top:0">
      <p class="chart-title">Every incident over time</p>
      <a class="small" href={url("/timeline/")}>By developer and by behavior →</a>
    </div>
    <Timeline id="home-timeline" />
  </section>

  <div class="two-col" style="margin-top:16px">
    <div class="chart-card"><HBars title="Most common behaviors" items={topBehaviors} valueHeader="Incidents" table={false} /></div>
    <div class="chart-card"><HBars title="Developers most often involved" items={topDevelopers} valueHeader="Incidents" table={false} /></div>
  </div>

  <!-- 2. Latest -->
  <div class="two-col">
    <section>
      <div class="section-head">
        <div><span class="eyebrow">Latest</span><h2>Recently added</h2></div>
        <a class="small" href={url("/incidents/")}>All incidents →</a>
      </div>
      <IncidentList incidents={latest} compact meta={(i) => `Added ${formatDate(i.record.created)}`} />
    </section>
    <section>
      <div class="section-head">
        <div><span class="eyebrow">Start here</span><h2>Highest impact</h2></div>
        <a class="small" href={url("/incidents/?harm=moderate")}>Filter by harm →</a>
      </div>
      <IncidentList incidents={impact} compact />
    </section>
  </div>

  <!-- 3. Explore -->
  <div class="section-head">
    <div><span class="eyebrow">Explore</span><h2>Go deeper</h2></div>
  </div>
  <div class="explore-grid">
    <a class="card" href={url("/incidents/")}><strong>Search &amp; filter</strong><span>All {n} records by behavior, model, developer, reach, harm, criminality, year</span></a>
    <a class="card" href={url("/timeline/")}><strong>Timeline</strong><span>Every incident over time, by developer or by behavior</span></a>
    <a class="card" href={url("/data/")}><strong>Data &amp; charts</strong><span>Breakdowns, reach × harm, and reported misbehavior rates per model</span></a>
    <a class="card" href={url("/behaviors/")}><strong>Behaviors</strong><span>{behaviors.length} kinds of misbehavior, from deception to sandbox escape</span></a>
    <a class="card" href={url("/models/")}><strong>Models</strong><span>{models.length - 1} models with their incident records</span></a>
    <a class="card" href={url("/api/incidents.json")}><strong>Download the data</strong><span>Full JSON export; YAML source on GitHub</span></a>
  </div>

  {scanStats.sources > 0 && (
    <p class="muted small" style="margin-top:28px">
      Kept current by a daily scout that has reviewed {scanStats.sources.toLocaleString("en-US")} sources since {formatDate(scanStats.since)}.
      New records are marked <span class="badge draft">Draft</span> until a maintainer checks every claim. <a href={url("/about/#status")}>How review works</a>.
    </p>
  )}
</Base>
