---
// Horizontal bars, one row per item, each split into segments by reach or by harm
// severity (each an ordinal one-hue ramp). Used wherever we'd otherwise show a bare count.
import { REACH, HARM, type Incident } from "../lib/data";
import OrgLogo from "./OrgLogo.astro";

interface Row { label: string; href?: string; incidents: Incident[]; logo?: string }
interface Props { rows: Row[]; max?: number; compact?: boolean; label?: string; by?: "reach" | "harm" }
const { rows, max, compact = false, label = "Incidents by reach", by = "reach" } = Astro.props;
const LEVELS: readonly string[] = by === "harm" ? HARM : REACH;
const levelOf = (i: Incident) => (by === "harm" ? i.assessment.harm.severity : i.assessment.reach.level);
const top = max ?? Math.max(1, ...rows.map((r) => r.incidents.length));
const split = (list: Incident[]) => LEVELS.map((l) => list.filter((i) => levelOf(i) === l).length);
---
<div class={`stackbars${compact ? " compact" : ""}`} role="img" aria-label={label}>
  {rows.map((row) => {
    const n = row.incidents.length;
    return (
      <>
        {!compact && (row.href
          ? <a class="sb-label with-logo" href={row.href}>{row.logo && <OrgLogo id={row.logo} title={false} />}<span>{row.label}</span></a>
          : <span class="sb-label with-logo">{row.logo && <OrgLogo id={row.logo} title={false} />}<span>{row.label}</span></span>)}
        <div class="sb-track">
          <div class="sb-bar" style={`width:${(n / top) * 100}%`}>
            {split(row.incidents).map((c, k) => c > 0 && (
              <span class="sb-seg" tabindex="0" style={`flex:${c}; background: var(--${by}-${LEVELS[k]})`} data-tip={`${row.label} · ${by === "harm" ? "harm " : ""}${LEVELS[k]}: ${c}`} />
            ))}
          </div>
          <span class="sb-val">{n}</span>
        </div>
      </>
    );
  })}
</div>
